# Server Settings
PORT=3000
NODE_ENV=production
SITE_URL=https://wajid.website
CORS_ORIGIN=https://wajid.website

# Security & JWT
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# Default Admin Setup
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_EMAIL=admin@wajidx.com
ADMIN_DEFAULT_PASSWORD=replace_with_a_unique_bootstrap_password

# ==============================================================================
# Supabase Configuration (Required for Vercel & Supabase Cloud)
# ==============================================================================
# 1. Project URL & API Keys (from Supabase Dashboard -> Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Supabase PostgreSQL Connection String (from Supabase Dashboard -> Settings -> Database -> Connection string / URI)
# Use Transaction pooler (Port 6543) or Session pooler (Port 5432)
SUPABASE_DB_URL=postgresql://postgres.your-project-id:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ==============================================================================
# Local MySQL Fallback (Optional for offline devaj local testing)
# ==============================================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=devaj
